# Database
DB_CONNECTION=Server=localhost;Port=3306;Database=OrderApp;User=root;Password=CHANGE_ME;

# JWT: use a random secret with at least 32 UTF-8 bytes
JWT_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET_OF_AT_LEAST_32_BYTES

# Email notifications (SMTP). Keep disabled until credentials are configured.
EMAIL_ENABLED=false
EMAIL_FROM=orders@example.com
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_SMTP_PORT=465
EMAIL_USERNAME=CHANGE_ME
EMAIL_PASSWORD=CHANGE_ME

# SMS notifications (Twilio). Use E.164 numbers, e.g. +27821234567.
SMS_ENABLED=false
SMS_ACCOUNT_SID=CHANGE_ME
SMS_AUTH_TOKEN=CHANGE_ME
SMS_FROM=+10000000000

# Geoapify (if used by PlacesController)
GEOAPIFY_API_KEY=CHANGE_ME

# Frontend Vite API URL (place this in the frontend .env file)
VITE_API_BASE_URL=http://localhost:5174/api
